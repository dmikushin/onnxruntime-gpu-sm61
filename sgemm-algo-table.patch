diff --git a/onnxruntime/core/providers/cuda/sgemm_algo_table.cc b/onnxruntime/core/providers/cuda/sgemm_algo_table.cc
new file mode 100644
index 0000000..8571613
--- /dev/null
+++ b/onnxruntime/core/providers/cuda/sgemm_algo_table.cc
@@ -0,0 +1,104 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#include "core/providers/shared_library/provider_api.h"
+#include "core/providers/cuda/sgemm_algo_table.h"
+
+#include <atomic>
+#include <fstream>
+#include <map>
+#include <shared_mutex>
+#include <sstream>
+#include <string_view>
+#include <tuple>
+
+namespace onnxruntime {
+namespace cuda {
+
+namespace {
+
+using Key = std::tuple<int, int, int, int, int, int, int, int, int64_t, int64_t, int64_t, int>;
+using Algos = std::map<Key, cublasGemmAlgo_t>;
+
+struct Table {
+  std::atomic<bool> loaded{false};  // no table: GEMMs skip the lock entirely
+  std::shared_mutex mutex;
+  std::map<std::string, Algos, std::less<>> by_device;  // std::less<>: look up by string_view
+};
+
+bool ValidOp(int op) { return op == CUBLAS_OP_N || op == CUBLAS_OP_T || op == CUBLAS_OP_C; }
+
+// cublasGemmAlgo_t values an fp32 GEMM can name: the default, ALGO0..23 and
+// the tensor-op ALGO0..15 (cuBLAS returns an error for the ones a GPU or
+// shape cannot run; the GEMM helpers fall back to cublasSgemm then).
+bool ValidAlgo(int algo) {
+  return (algo >= CUBLAS_GEMM_DEFAULT && algo <= CUBLAS_GEMM_ALGO23) ||
+         (algo >= CUBLAS_GEMM_DEFAULT_TENSOR_OP && algo <= CUBLAS_GEMM_ALGO15_TENSOR_OP);
+}
+
+Table& GetTable() {
+  static Table table;
+  return table;
+}
+
+Key MakeKey(const SgemmShape& s) {
+  return Key{s.transa, s.transb, s.m, s.n, s.k, s.lda, s.ldb, s.ldc,
+             s.stride_a, s.stride_b, s.stride_c, s.batch};
+}
+
+}  // namespace
+
+Status LoadSgemmAlgoTable(const std::string& path) {
+  std::ifstream in(path);
+  ORT_RETURN_IF_NOT(in, "sgemm_algo_table: cannot read ", path);
+  std::map<std::string, Algos> loaded;
+  std::string line, device;
+  for (int line_no = 1; std::getline(in, line); ++line_no) {
+    std::istringstream fields(line);
+    std::string kind;
+    if (!(fields >> kind) || kind[0] == '#') continue;
+    if (kind == "device") {
+      std::getline(fields >> std::ws, device);
+      continue;
+    }
+    ORT_RETURN_IF_NOT(kind == "gemm" || kind == "batched", path, ":", line_no,
+                      ": expected device, gemm or batched");
+    ORT_RETURN_IF(device.empty(), path, ":", line_no, ": entry before any device line");
+    int transa, transb, algo;
+    SgemmShape s{};
+    fields >> transa >> transb >> s.m >> s.n >> s.k >> s.lda >> s.ldb >> s.ldc;
+    if (kind == "batched") fields >> s.stride_a >> s.stride_b >> s.stride_c >> s.batch;
+    fields >> algo;
+    std::string extra;
+    ORT_RETURN_IF_NOT(fields && !(fields >> extra), path, ":", line_no, ": malformed ", kind,
+                      " entry");
+    ORT_RETURN_IF_NOT(ValidOp(transa) && ValidOp(transb) && s.m > 0 && s.n > 0 && s.k > 0 &&
+                          s.lda > 0 && s.ldb > 0 && s.ldc > 0 && (kind == "gemm" || s.batch > 0),
+                      path, ":", line_no, ": invalid shape in ", kind, " entry");
+    ORT_RETURN_IF_NOT(ValidAlgo(algo), path, ":", line_no, ": invalid cublasGemmAlgo_t ", algo);
+    s.transa = static_cast<cublasOperation_t>(transa);
+    s.transb = static_cast<cublasOperation_t>(transb);
+    loaded[device][MakeKey(s)] = static_cast<cublasGemmAlgo_t>(algo);
+  }
+  Table& table = GetTable();
+  std::unique_lock lock(table.mutex);
+  for (auto& [device, algos] : loaded) {
+    Algos& to = table.by_device[device];
+    for (auto& [key, algo] : algos) to[key] = algo;
+  }
+  table.loaded = !table.by_device.empty();
+  return Status::OK();
+}
+
+cublasGemmAlgo_t SgemmAlgo(const cudaDeviceProp& prop, const SgemmShape& shape) {
+  Table& table = GetTable();
+  if (!table.loaded) return CUBLAS_GEMM_DEFAULT;
+  std::shared_lock lock(table.mutex);
+  auto device = table.by_device.find(std::string_view{prop.name});
+  if (device == table.by_device.end()) return CUBLAS_GEMM_DEFAULT;
+  auto it = device->second.find(MakeKey(shape));
+  return it == device->second.end() ? CUBLAS_GEMM_DEFAULT : it->second;
+}
+
+}  // namespace cuda
+}  // namespace onnxruntime
diff --git a/onnxruntime/core/providers/cuda/sgemm_algo_table.h b/onnxruntime/core/providers/cuda/sgemm_algo_table.h
new file mode 100644
index 0000000..8a4f769
--- /dev/null
+++ b/onnxruntime/core/providers/cuda/sgemm_algo_table.h
@@ -0,0 +1,51 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+// Per-shape cuBLAS algorithm overrides for fp32 GEMMs.
+//
+// cublasSgemm lets cuBLAS's heuristic pick the kernel. On some GPUs (Pascal
+// in particular) that choice is often well off the fastest algorithm for the
+// shape, by up to 3x per GEMM. A table measured offline on the target GPU
+// names the cublasGemmEx algorithm to use per exact shape; shapes not in the
+// table keep cublasSgemm. The table is loaded from the file given in the CUDA
+// EP provider option `sgemm_algo_table` and applies to every GPU of the same
+// model (cudaDeviceProp::name) in the process.
+//
+// File format: text, fields separated by blanks, '#' starts a comment line.
+//   device <cudaDeviceProp::name>
+//   gemm    <transa> <transb> <m> <n> <k> <lda> <ldb> <ldc> <algo>
+//   batched <transa> <transb> <m> <n> <k> <lda> <ldb> <ldc> <strideA> <strideB> <strideC> <batch> <algo>
+// transa/transb are cublasOperation_t values, algo a cublasGemmAlgo_t value;
+// the arguments are those of cublasSgemm / cublasSgemmStridedBatched. Entries
+// apply to the device named by the latest preceding `device` line.
+// A GPU that cannot run a tabled algorithm after all gets cublasSgemm's choice.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <cublas_v2.h>
+#include <cuda_runtime.h>
+
+#include "core/providers/shared_library/provider_api.h"
+
+namespace onnxruntime {
+namespace cuda {
+
+struct SgemmShape {
+  cublasOperation_t transa, transb;
+  int m, n, k, lda, ldb, ldc;
+  int64_t stride_a = 0, stride_b = 0, stride_c = 0;
+  int batch = 0;  // 0: cublasSgemm, else cublasSgemmStridedBatched
+};
+
+// Adds the entries of `path` to the process-wide table (later entries for
+// the same device and shape replace earlier ones).
+Status LoadSgemmAlgoTable(const std::string& path);
+
+// The algorithm tabled for `shape` on a GPU like `prop`, else CUBLAS_GEMM_DEFAULT.
+cublasGemmAlgo_t SgemmAlgo(const cudaDeviceProp& prop, const SgemmShape& shape);
+
+}  // namespace cuda
+}  // namespace onnxruntime
